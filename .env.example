# Gemini model is supplied by the API client. No model selector is included.
GEMINI_THINKING=1
GEMINI_THINKING_LEVEL=auto
GEMINI_THINKING_BUDGET=-1
GEMINI_INCLUDE_THOUGHT_SUMMARIES=0
GEMINI_GOOGLE_SEARCH=0
GEMINI_PREFILL_MODE=nudge
# Optional generation defaults. Leave blank to use Google's defaults.
GEMINI_TEMPERATURE=
GEMINI_TOP_P=
GEMINI_TOP_K=
GEMINI_MAX_OUTPUT_TOKENS=
